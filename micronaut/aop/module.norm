    ],
    exports: ["Around", "AroundProxyTargetConstructorMode", "InterceptorBean", "MethodInterceptor", "InvocationContext", "MethodInvocationContext"],
    binding: jarBinding(
      target: mavenJar(
        group: "io.micronaut",
        artifact: "micronaut-aop",
        version: "5.1.13", resolution: sha256("137afc1824ea4e86fa952562feaf2f8fc4ff4fe3e6f85727eaa059c6a2570569")
      ),
      api: [
        jarType(name: "io.micronaut.aop.Around", alias: "Around", members: ["cacheableLazyTarget", "hotswap", "lazy", "proxyTarget", "proxyTargetMode"]),
        jarType(name: "io.micronaut.aop.Around.ProxyTargetConstructorMode", alias: "AroundProxyTargetConstructorMode", members: []),
        jarType(name: "io.micronaut.aop.InterceptorBean", alias: "InterceptorBean", members: ["value"]),
        jarType(
